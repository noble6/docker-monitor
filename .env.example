# ==========================================
# CyberSec Control Center - Environment Configuration
# ==========================================
# IMPORTANT: Never commit actual secrets to version control.
# Copy this file to `.env` and configure real values there.

# [REQUIRED IN PRODUCTION] Flask session and CSRF signing key.
# Generate a secure key using: `python -c 'import secrets; print(secrets.token_hex(32))'`
SECRET_KEY=

# [REQUIRED IN PRODUCTION] Dashboard authentication credentials.
# The dashboard will fail to start if these are missing unless APP_ENV=development.
DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_PASSWORD=

# Set to "production" to enforce strict security constraints.
APP_ENV=production

# (Optional) Disable auth for local development ONLY.
DASHBOARD_ALLOW_INSECURE=false

# ------------------------------------------
# TLS Deployment Configuration (Example)
# ------------------------------------------
# The dashboard runs using a Gunicorn + Nginx reverse proxy architecture for TLS.
# No need to set TLS certs directly in Flask. Let Nginx handle HTTPS termination.
# Example Nginx config is documented in README.md under 'Production Deployment'.
